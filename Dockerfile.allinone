# syntax=docker/dockerfile:1

# MoonlightBox All-in-One 镜像:前端 + 后端 API + LightRAG sidecar +
# 三类 worker,单容器即可完整体验。本版不含本地 LoRA 训练/推理(linux-ml),
# 人格回复由云端认知模型生成;分体式含 GPU 的部署仍使用根 Dockerfile 与
# docker-compose.yml。

FROM node:22-bookworm-slim AS frontend-builder

WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --registry=https://registry.npmjs.org --replace-registry-host=always
COPY frontend/ ./
RUN npm run build

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

LABEL org.opencontainers.image.source="https://github.com/AMOS144/MoonlightBox" \
      org.opencontainers.image.description="MoonlightBox all-in-one: chat memory analysis and persona branch exploration"

WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH"

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx supervisor curl \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

COPY pyproject.toml uv.lock README.md ./
# 构建网络偶发超时,放宽 uv 的下载超时。
ENV UV_HTTP_TIMEOUT=300
RUN uv sync --frozen --no-dev --no-install-project

# LightRAG sidecar 打进同一虚拟环境;依赖(fastapi/uvicorn/httpx)与后端兼容。
COPY sidecars/lightrag_sidecar ./sidecars/lightrag_sidecar
RUN uv pip install --python /app/.venv/bin/python ./sidecars/lightrag_sidecar

COPY backend ./backend
COPY docker ./docker
RUN chmod +x /app/docker/all-in-one-entrypoint.sh

COPY docker/nginx.allinone.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-builder /frontend/dist /usr/share/nginx/html

# 运行期默认值;LLM key 不在镜像内,运行时通过 --env-file 或 Web 设置页提供。
ENV PYTHONPATH=/app/backend \
    MOONLIGHTBOX_DATA_DIR=/app/data \
    MOONLIGHTBOX_DATABASE_URL=sqlite:////app/data/moonlightbox.db \
    MOONLIGHTBOX_CHROMA_DIR=/app/data/chroma \
    MOONLIGHTBOX_MODEL_DIR=/app/data/models \
    MOONLIGHTBOX_AUTO_CREATE_SCHEMA=false \
    MOONLIGHTBOX_LIGHTRAG_ENABLED=true \
    MOONLIGHTBOX_LIGHTRAG_SIDECAR_URL=http://127.0.0.1:9621 \
    MOONLIGHTBOX_LIGHTRAG_SIDECAR_TOKEN=development-only-token \
    LIGHTRAG_SIDECAR_STORAGE_DIR=/app/data/lightrag \
    LIGHTRAG_SIDECAR_API_TOKEN=development-only-token \
    LIGHTRAG_SIDECAR_HOST=127.0.0.1 \
    LIGHTRAG_SIDECAR_PORT=9621

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 \
    CMD curl -fsS http://127.0.0.1/api/health || exit 1

ENTRYPOINT ["/app/docker/all-in-one-entrypoint.sh"]
