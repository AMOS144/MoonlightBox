# MoonlightBox All-in-One 运行时配置模板。
# 复制为 .env(或任意文件名)并填入真实 key,然后:
#   docker run -d --name moonlightbox -p 8080:80 \
#     -v moonlightbox-data:/app/data \
#     --env-file .env ghcr.io/amos144/moonlightbox:latest
# 本版镜像不含本地 LoRA 训练/推理,人格回复由云端认知模型生成,无需 GPU。

# ---- 云端 LLM(默认 MiniMax,OpenAI 兼容接口,可换成任意兼容服务)----
MOONLIGHTBOX_NODE_ANALYSIS_ENABLED=true
MOONLIGHTBOX_NODE_ANALYSIS_ENDPOINT=https://api.minimaxi.com/v1/chat/completions
MOONLIGHTBOX_NODE_ANALYSIS_MODEL=MiniMax-M3
MOONLIGHTBOX_NODE_ANALYSIS_API_KEY=YOUR_MINIMAX_API_KEY

MOONLIGHTBOX_COGNITION_ENDPOINT=https://api.minimaxi.com/v1/chat/completions
MOONLIGHTBOX_COGNITION_MODEL=MiniMax-M3
MOONLIGHTBOX_COGNITION_API_KEY=YOUR_MINIMAX_API_KEY

# ---- LightRAG 图谱:LLM ----
LIGHTRAG_SIDECAR_LLM_BASE_URL=https://api.minimaxi.com/v1
LIGHTRAG_SIDECAR_LLM_MODEL=MiniMax-M2.7-highspeed
LIGHTRAG_SIDECAR_LLM_API_KEY=YOUR_MINIMAX_API_KEY

# ---- LightRAG 图谱:Embedding(示例为阿里云百炼兼容接口)----
LIGHTRAG_SIDECAR_EMBEDDING_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LIGHTRAG_SIDECAR_EMBEDDING_MODEL=text-embedding-v4
LIGHTRAG_SIDECAR_EMBEDDING_DIMENSION=1024
LIGHTRAG_SIDECAR_EMBEDDING_API_KEY=YOUR_EMBEDDING_API_KEY

# ---- 可选:高德地图 Web 服务 key(地区热点图;留空则关闭云端地理解析)----
MOONLIGHTBOX_SPATIAL_AMAP_WEB_KEY=

# cognition / node_analysis 的模型与 key 也可以启动后在 Web「设置」页配置,
# 保存在数据卷的 agent-model-settings.json 中,优先级高于环境变量。
