LIGHTRAG_SIDECAR_STORAGE_DIR=/var/lib/moonlightbox-lightrag
LIGHTRAG_SIDECAR_API_TOKEN=development-only-token
LIGHTRAG_SIDECAR_HOST=127.0.0.1
LIGHTRAG_SIDECAR_PORT=9621
LIGHTRAG_SIDECAR_LLM_BASE_URL=https://api.deepseek.com/v1
LIGHTRAG_SIDECAR_LLM_MODEL=deepseek-chat
LIGHTRAG_SIDECAR_LLM_API_KEY=
LIGHTRAG_SIDECAR_LLM_MAX_TOKENS=32768
LIGHTRAG_SIDECAR_SUMMARY_CONTEXT_SIZE=100000
LIGHTRAG_SIDECAR_SUMMARY_MAX_TOKENS=100000
LIGHTRAG_SIDECAR_FORCE_LLM_SUMMARY_ON_MERGE=100000
# 百炼华北 2（北京）；复制后把 YOUR_WORKSPACE_ID 替换为业务空间 ID。
LIGHTRAG_SIDECAR_EMBEDDING_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LIGHTRAG_SIDECAR_EMBEDDING_MODEL=text-embedding-v4
LIGHTRAG_SIDECAR_EMBEDDING_DIMENSION=1024
LIGHTRAG_SIDECAR_EMBEDDING_MAX_TOKENS=8192
LIGHTRAG_SIDECAR_EMBEDDING_API_KEY=
