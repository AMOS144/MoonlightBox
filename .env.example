MOONLIGHTBOX_HOST_DATA_DIR=../.runtime-data/data
MOONLIGHTBOX_DATA_DIR=../.runtime-data/data
MOONLIGHTBOX_DATABASE_URL=sqlite:///../.runtime-data/data/moonlightbox.db
MOONLIGHTBOX_BEHAVIORAL_TIMEZONE_OFFSET_MINUTES=480
MOONLIGHTBOX_CHROMA_DIR=../.runtime-data/data/chroma
MOONLIGHTBOX_MODEL_DIR=models
# 本机 Phoenix Trace 浏览器。标准 ./scripts/start.sh 会覆盖为 true，以便直接分析
# Agent 的输入、工具返回和模型输出；只可连接你控制的本机 Collector。
MOONLIGHTBOX_PHOENIX_ENABLED=true
MOONLIGHTBOX_PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
MOONLIGHTBOX_PHOENIX_PROJECT_NAME=moonlightbox
MOONLIGHTBOX_PHOENIX_CAPTURE_CONTENT=true
MOONLIGHTBOX_PHOENIX_TRACE_MAX_CHARACTERS=64000
MOONLIGHTBOX_PHOENIX_ANNOTATIONS_ENABLED=true
MOONLIGHTBOX_BACKEND_PORT=8001
MOONLIGHTBOX_FRONTEND_PORT=5175
PERSONA_RUNTIME_PORT=8765
# 模拟生活默认关闭：迁移 0055 后显式开启；不启用 LoRA，不更换认知模型。
# 可覆盖默认概率策略；留空使用内置 YAML，无生活推进启停开关。
MOONLIGHTBOX_RUNTIME_LIFE_POLICY_PATH=
# Linux/WSL 默认在本机启动人格服务；Docker 内默认使用 persona-runtime 服务名。
MOONLIGHTBOX_PERSONA_INFERENCE_URL=http://127.0.0.1:8765
MOONLIGHTBOX_PERSONA_INFERENCE_TOKEN=development-only-token
MOONLIGHTBOX_PERSONA_DEVICE=auto
MOONLIGHTBOX_PERSONA_LOAD_IN_4BIT=true
MOONLIGHTBOX_AUTO_CREATE_SCHEMA=false
MOONLIGHTBOX_CLOUD_EVALUATION_ENABLED=true
MOONLIGHTBOX_CLOUD_EVALUATION_ENDPOINT=https://api.deepseek.com/chat/completions
MOONLIGHTBOX_CLOUD_EVALUATION_MODEL=deepseek-v4-flash
MOONLIGHTBOX_CLOUD_EVALUATION_API_KEY=YOUR_MINIMAX_API_KEY
MOONLIGHTBOX_NODE_ANALYSIS_ENABLED=true
MOONLIGHTBOX_SPATIAL_ANALYSIS_ENABLED=true
MOONLIGHTBOX_SPATIAL_ANALYSIS_BACKEND=cloud
MOONLIGHTBOX_SPATIAL_AMAP_WEB_KEY=
MOONLIGHTBOX_SPATIAL_PROVIDER_PERSISTENCE_ALLOWED=false
MOONLIGHTBOX_SPATIAL_HEATMAP_DEFAULT_PRIVACY=blurred
MOONLIGHTBOX_NODE_ANALYSIS_ENDPOINT=https://api.minimaxi.com/v1/chat/completions
MOONLIGHTBOX_NODE_ANALYSIS_MODEL=MiniMax-M3
MOONLIGHTBOX_NODE_ANALYSIS_API_KEY=YOUR_MINIMAX_API_KEY
MOONLIGHTBOX_NODE_ANALYSIS_RESPONSE_FORMAT=json_object
MOONLIGHTBOX_NODE_ANALYSIS_THINKING_MODE=default
MOONLIGHTBOX_NODE_ANALYSIS_MAX_OUTPUT_TOKENS=8192
MOONLIGHTBOX_COGNITION_BACKEND=local
MOONLIGHTBOX_COGNITION_ENDPOINT=https://api.minimaxi.com/v1/chat/completions
MOONLIGHTBOX_COGNITION_MODEL=MiniMax-M3
MOONLIGHTBOX_COGNITION_API_KEY=YOUR_MINIMAX_API_KEY
MOONLIGHTBOX_COGNITION_TIMEOUT_SECONDS=90
MOONLIGHTBOX_COGNITION_MAX_RETRIES=2
MOONLIGHTBOX_COGNITION_RESPONSE_FORMAT=json_object
MOONLIGHTBOX_COGNITION_THINKING_MODE=default
MOONLIGHTBOX_COGNITION_MAX_OUTPUT_TOKENS=4096
MOONLIGHTBOX_REPLY_REVIEW_ENABLED=false
MOONLIGHTBOX_WORK_CALENDAR_ENABLED=true
MOONLIGHTBOX_WORK_CALENDAR_CACHE_DIR=../.runtime-data/data/calendar-cache/cn
MOONLIGHTBOX_WORK_CALENDAR_REFRESH_HOURS=24
MOONLIGHTBOX_WORK_CALENDAR_TIMEOUT_SECONDS=5
MOONLIGHTBOX_NODE_ANALYSIS_TIMEOUT_SECONDS=60
MOONLIGHTBOX_WORLD_COMPILER_TIMEOUT_SECONDS=7200
MOONLIGHTBOX_NODE_ANALYSIS_MAX_RETRIES=3
MOONLIGHTBOX_NODE_ANALYSIS_BACKOFF_SECONDS=0.5
MOONLIGHTBOX_NODE_ANALYSIS_MAX_BACKOFF_SECONDS=60
MOONLIGHTBOX_NODE_ANALYSIS_MAX_RETRY_AFTER_SECONDS=3600
MOONLIGHTBOX_LIGHTRAG_ENABLED=true
MOONLIGHTBOX_LIGHTRAG_SIDECAR_URL=http://127.0.0.1:9621
MOONLIGHTBOX_LIGHTRAG_SIDECAR_TOKEN=development-only-token
MOONLIGHTBOX_LIGHTRAG_INDEX_REVISION=person-world-v1
MOONLIGHTBOX_LIGHTRAG_TIMEOUT_SECONDS=7200
MOONLIGHTBOX_LIGHTRAG_BUNDLE_GAP_HOURS=6
MOONLIGHTBOX_LIGHTRAG_BUNDLE_MAX_CHARACTERS=12000
MOONLIGHTBOX_LIGHTRAG_CARRY_IN_TURNS=3
MOONLIGHTBOX_LIGHTRAG_QUERY_TOP_K=30
MOONLIGHTBOX_LIGHTRAG_QUERY_CHUNK_TOP_K=12
MOONLIGHTBOX_LIGHTRAG_QUERY_MAX_TOTAL_TOKENS=16000
# PersonWorld 的七个栏目独立有界并发；遇到供应商限流会自动降级。
MOONLIGHTBOX_PERSON_WORLD_SECTION_CONCURRENCY=3
MOONLIGHTBOX_PERSON_WORLD_SECTION_MAX_TOOL_CALLS=48
MOONLIGHTBOX_PERSON_WORLD_SECTION_DEADLINE_SECONDS=900
MOONLIGHTBOX_PERSON_WORLD_SECTION_MAX_STALLED_CYCLES=2
MOONLIGHTBOX_PERSON_WORLD_SECTION_MODEL_TIMEOUT_SECONDS=300
MOONLIGHTBOX_PERSON_WORLD_SECTION_TOOL_TIMEOUT_SECONDS=300
LIGHTRAG_SIDECAR_LLM_BASE_URL=https://api.minimaxi.com/v1
LIGHTRAG_SIDECAR_LLM_MODEL=MiniMax-M2.7-highspeed
LIGHTRAG_SIDECAR_LLM_REASONING_SPLIT=true
LIGHTRAG_SIDECAR_LLM_TIMEOUT_SECONDS=3600
LIGHTRAG_SIDECAR_LLM_API_KEY=YOUR_MINIMAX_API_KEY
# 百炼华北 2（北京）；复制后把 YOUR_WORKSPACE_ID 替换为业务空间 ID。
LIGHTRAG_SIDECAR_MAX_PARALLEL_INSERT=3
LIGHTRAG_SIDECAR_MAX_ASYNC_LLM=5
# 同一 workspace 跨进程只允许一个索引 owner；TTL 到期后才回收崩溃进程的租约。
LIGHTRAG_SIDECAR_INDEX_LEASE_TTL_SECONDS=120
LIGHTRAG_SIDECAR_EMBEDDING_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LIGHTRAG_SIDECAR_EMBEDDING_MODEL=text-embedding-v4
LIGHTRAG_SIDECAR_EMBEDDING_DIMENSION=1024
LIGHTRAG_SIDECAR_EMBEDDING_MAX_TOKENS=8192
LIGHTRAG_SIDECAR_EMBEDDING_API_KEY=YOUR_ALIYUN_BAILIAN_API_KEY
MOONLIGHTBOX_TRAINING_BASE_MODEL=Qwen/Qwen3-1.7B@70d244cc86ccca08cf5af4e1e306ecf908b1ad5e
MOONLIGHTBOX_TRAINING_ITERATIONS=600
MOONLIGHTBOX_TRAINING_BATCH_SIZE=1
MOONLIGHTBOX_TRAINING_LEARNING_RATE=0.00001
MOONLIGHTBOX_TRAINING_GRADIENT_ACCUMULATION_STEPS=4
MOONLIGHTBOX_TRAINING_MAX_SEQ_LENGTH=512
MOONLIGHTBOX_TRAINING_MAXIMUM_EVENT_RATIO=0.25
MOONLIGHTBOX_TRAINING_CONTEXT_TURNS=12
MOONLIGHTBOX_TRAINING_PROTOCOL_VERSION=persona-plain-text-private-chat-v15
MOONLIGHTBOX_HUMAN_BLIND_REQUIRED=true
MOONLIGHTBOX_HUMAN_BLIND_MINIMUM_RATINGS=20
MOONLIGHTBOX_HUMAN_BLIND_MINIMUM_PREFERENCE=0.5
MOONLIGHTBOX_CHECKPOINT_SELECTION_VERSION=person-identity-held-out-v8
MOONLIGHTBOX_REPLY_PROTOCOL_VERSION=persona-text-v1
MOONLIGHTBOX_MEMORY_PROTOCOL_VERSION=semantic-cutoff-v1
